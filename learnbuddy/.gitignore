# Claude / AI assistant artifacts
docs/superpowers/
docs/plans/
.env
# learnbuddy packages — accidental `tsc` emit beside sources (use Vite aliases, not dist/)
packages/*/src/**/*.js
packages/*/src/**/*.js.map
!packages/shared/src/brand.mjs
packages/*/src/**/*.d.ts
packages/*/src/**/*.d.ts.map
!packages/shared/src/brand.d.ts
!packages/platform/src/preload-api.d.ts
!packages/ui/vite-env.d.ts
!packages/ui/src/types/react-syntax-highlighter-subpaths.d.ts
# apps — same rule (e.g. apps/web/src/main.js from mistaken tsc)
apps/*/src/**/*.js
apps/*/src/**/*.js.map
apps/*/src/**/*.d.ts
apps/*/src/**/*.d.ts.map

# relay-server — stray shell/node eval artifacts
relay-server/console.log*
relay-server/r.json*

# webui (monorepo frontend)
webui/node_modules/
webui/dist/
webui/coverage/
webui/.vite/
*.tsbuildinfo
desktop/node_modules/
