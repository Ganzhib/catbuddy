# catbuddy monorepo — cp .env.example .env
#
# ┌─────────────────────────────────────────────────────────────┐
# │  CATBUDDY_DEV_MODE=local   → pnpm gateway:dev + dev:desktop   │
# │                            + dev:web（全走 127.0.0.1:18765） │
# │  CATBUDDY_DEV_MODE=remote  → dev:desktop + dev:web 连线上    │
# │                            （无需 pnpm gateway:dev）          │
# └─────────────────────────────────────────────────────────────┘

CATBUDDY_DEV_MODE=local

GATEWAY_ACCOUNT_EMAIL=you@example.com
DEEPSEEK_KEY=your-deepseek-key-here

# 本地 gateway:dev 发注册邮件（remote 模式可省略）
# SMTP_HOST=smtp.qq.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=your-email@qq.com
# SMTP_PASS=your-smtp-authorization-code
# SMTP_FROM=catbuddy <your-email@qq.com>

# MySQL（本地 gateway:dev，默认值通常够用）
# MYSQL_USER=catbuddy
# MYSQL_PASSWORD=catbuddy
# MYSQL_DATABASE=catbuddy_gateway

# 生产 / Docker / 打包 → cp .env.production.example .env.production
