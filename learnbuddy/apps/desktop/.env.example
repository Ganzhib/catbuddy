

# DeepSeek (对话)
DEEPSEEK_KEY=your-deepseek-key-here

# OpenAI (图片生成 / fallback)
OPENAI_API_KEY=your-openai-key-here

# ── Gateway ──
# 打包版 / LEARNBUDDY_GATEWAY_USE_LOCAL=false → 内置 gateway.ganzhibin.icu
# 本地开发连 gateway:dev:
#   LEARNBUDDY_GATEWAY_USE_LOCAL=true
#   GATEWAY_URL=ws://127.0.0.1:18765/ws
#   GATEWAY_SECRET=dev-secret
# GATEWAY_ENABLED=false          # 完全禁用远程

# Gateway 服务端见 gateway/.env.example
