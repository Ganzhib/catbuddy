{
  "name": "@catbuddy/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "catbuddy desktop — Electron + local agent",
  "main": "dist-electron/index.js",
  "type": "module",
  "scripts": {
    "clean:electron": "node -e \"require('node:fs').rmSync('dist-electron',{recursive:true,force:true})\"",
    "dev": "vite",
    "dev:fresh": "pnpm run clean:electron && vite",
    "build": "node ../../scripts/desktop-build.mjs",
    "build:verbose": "node ../../scripts/desktop-build.mjs --verbose",
    "build:nsis": "node ../../scripts/desktop-build.mjs",
    "build:nsis:verbose": "node ../../scripts/desktop-build.mjs --verbose",
    "build:unpack": "node ../../scripts/desktop-build.mjs --dir",
    "build:unpack:verbose": "node ../../scripts/desktop-build.mjs --dir --verbose",
    "build:vite": "tsc --noEmit && vite build",
    "build:unpack:fresh": "node ../../scripts/desktop-build.mjs --dir --config.directories.output=release-fresh",
    "kill-app": "node ../../scripts/kill-desktop-processes.mjs",
    "rebuild:unpack": "pnpm run kill-app && pnpm run build:unpack",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "gateway:dev": "pnpm --filter @catbuddy/gateway dev",
    "gateway:test": "node ../../gateway/test-all.mjs",
    "brand:generate": "node ../../scripts/generate-brand.mjs",
    "brand:cutout": "node ../../scripts/remove-icon-background.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.37.0",
    "@catbuddy/client": "workspace:*",
    "@catbuddy/gateway-sdk-desktop": "workspace:*",
    "@catbuddy/platform": "workspace:*",
    "@catbuddy/shared": "workspace:*",
    "@catbuddy/ui": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "handlebars": "^4.7.8",
    "js-tiktoken": "^1.0.19",
    "langfuse": "^3.38.20",
    "nanoid": "^5.0.0",
    "openai": "^4.73.0",
    "ws": "^8.18.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@imgly/background-removal-node": "^1.4.5",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.1",
    "electron-builder": "^25.0.0",
    "postcss": "^8.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "semver": "^7.6.0",
    "sharp": "^0.33.5",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.7.2",
    "vite": "^5.4.21",
    "vite-plugin-electron": "^0.28.0",
    "vite-plugin-electron-renderer": "^0.14.0"
  },
  "build": {
    "appId": "com.catbuddy.desktop",
    "productName": "catbuddy",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "src/main/assets/**/*",
      "templates/**/*",
      "skills/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "src/main/assets/icon.png",
      "artifactName": "${productName}-Setup-${version}-${env.BUILD_TIMESTAMP}.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "src/main/assets/icon.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "src/main/assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
