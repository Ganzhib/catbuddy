# learnbuddy Desktop 环境变量
# 复制此文件为 .env 并填入你的 API keys

# DeepSeek (对话)
DEEPSEEK_KEY=your-deepseek-key-here

# OpenAI (图片生成 / fallback)
OPENAI_API_KEY=your-openai-key-here

# ── Gateway 客户端（桌面/Web 连接地址，放本文件即可）──
GATEWAY_ENABLED=true
GATEWAY_URL=ws://127.0.0.1:18765/ws
GATEWAY_SECRET=dev-secret

# Gateway 服务端配置（SMTP、JWT、端口等）请写在 gateway/.env
# 见 gateway/.env.example → 复制为 gateway/.env

