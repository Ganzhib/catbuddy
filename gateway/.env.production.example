# catbuddy Gateway — 生产环境
# 用法:
#   cp gateway/.env.production.example gateway/.env.production
#   填写 GATEWAY_JWT_SECRET、SMTP_*（可从 gateway/.env 复制邮件段）
#
# Docker:
#   docker compose -f gateway/docker-compose.yml --env-file gateway/.env.production up -d --build
#   或在 compose 里把 env_file 改为 .env.production
#
# Node（服务器上）:
#   set NODE_ENV=production   # Linux: export NODE_ENV=production
#   pnpm gateway:start        # 自动加载 gateway/.env.production

GATEWAY_PORT=18765

# 须与 packages/shared gateway-endpoints.ts → CATBUDDY_GATEWAY_DESKTOP_SECRET
GATEWAY_SECRET=catbuddy-desktop-pair-v1

# Nginx 反代 /ws → :18765/ws
GATEWAY_WS_PATH=/ws

GATEWAY_AUTH_REQUIRE_EMAIL=true
GATEWAY_AUTH_DEV_BYPASS=false

# 必改：随机长字符串（openssl rand -hex 32）
GATEWAY_JWT_SECRET=REPLACE_WITH_RANDOM_SECRET

# Docker Compose 会覆盖为 mysql；仅 Node+本机 MySQL 时用 127.0.0.1
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=catbuddy
MYSQL_PASSWORD=catbuddy
MYSQL_DATABASE=catbuddy_gateway

# ── 注册验证码邮件（从 gateway/.env 复制你的 QQ SMTP 即可）──
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@qq.com
SMTP_PASS=your-smtp-authorization-code
SMTP_FROM=catbuddy <your-email@qq.com>

# 若 465 不通可改用:
# SMTP_PORT=587
# SMTP_SECURE=false
