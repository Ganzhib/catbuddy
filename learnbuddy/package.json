{
  "name": "learnbuddy",
  "private": true,
  "version": "0.1.0",
  "description": "learnbuddy monorepo — desktop + web",
  "scripts": {
    "dev": "pnpm --filter @learnbuddy/desktop dev",
    "dev:desktop": "pnpm --filter @learnbuddy/desktop dev",
    "dev:desktop:gateway": "pnpm --filter @learnbuddy/desktop dev",
    "dev:web": "pnpm --filter @learnbuddy/web dev",
    "dev:web:full": "concurrently -k -n gateway,web \"pnpm gateway:dev\" \"pnpm --filter @learnbuddy/web dev\"",
    "build": "pnpm --filter @learnbuddy/desktop build",
    "build:all": "pnpm gateway:build && pnpm build:web && pnpm build:desktop",
    "build:desktop": "pnpm --filter @learnbuddy/desktop build",
    "build:web": "pnpm --filter @learnbuddy/web build",
    "lint": "pnpm -r lint",
    "clean:packages": "node scripts/clean-package-emit.mjs",
    "gateway:dev": "pnpm --filter @learnbuddy/gateway dev",
    "dev:gateway": "pnpm gateway:dev",
    "gateway:build": "pnpm --filter @learnbuddy/gateway build",
    "gateway:start": "pnpm --filter @learnbuddy/gateway start",
    "gateway:test": "pnpm --dir gateway test:e2e",
    "gateway:test:acceptance": "pnpm --dir gateway test:acceptance",
    "gateway:test:all": "pnpm --dir gateway test:all"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.7.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "sharp",
      "onnxruntime-node"
    ]
  }
}
