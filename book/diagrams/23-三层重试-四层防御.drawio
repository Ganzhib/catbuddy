<mxfile><diagram name="架构图" id="diagram-1"><mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="四层防线 — Agent 翻车优雅降级系统" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1a1a2e;fontColor=#ffffff;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="100" y="15" width="460" height="40" as="geometry"/></mxCell><mxCell id="3" value="Layer 1: Provider 重试 (base-provider.ts)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#c8e6c9;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="620" height="32" as="geometry"/></mxCell><mxCell id="4" value="指数退避: [1s, 2s, 4s]&lt;br&gt;瞬态错误: 429 · 5xx · timeout → 重试&lt;br&gt;永久错误: 4xx (非429) → 不重试&lt;br&gt;AbortError → 直接穿透 (用户stop)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontSize=10;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="40" y="118" width="310" height="72" as="geometry"/></mxCell><mxCell id="5" value="standard: max 3 retries&lt;br&gt;persistent: 无限 (后台任务)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontSize=10;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="380" y="118" width="200" height="45" as="geometry"/></mxCell><mxCell id="6" value="Layer 2: Fallback 链切换 (fallback.ts)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff9c4;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="210" width="620" height="32" as="geometry"/></mxCell><mxCell id="7" value="DeepSeek-V3 (主模型)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="252" width="150" height="40" as="geometry"/></mxCell><mxCell id="8" value="→ 挂了" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;fontSize=10;" vertex="1" parent="1"><mxGeometry x="200" y="260" width="50" height="24" as="geometry"/></mxCell><mxCell id="9" value="Claude-3.5-Sonnet" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe0b2;fontSize=10;" vertex="1" parent="1"><mxGeometry x="260" y="252" width="150" height="40" as="geometry"/></mxCell><mxCell id="10" value="→ 挂了" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;fontSize=10;" vertex="1" parent="1"><mxGeometry x="420" y="260" width="50" height="24" as="geometry"/></mxCell><mxCell id="11" value="GPT-4o (底线)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffcc80;fontSize=10;" vertex="1" parent="1"><mxGeometry x="480" y="252" width="150" height="40" as="geometry"/></mxCell><mxCell id="12" value="全挂 → 'All providers failed' 兜底消息" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffcdd2;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="180" y="305" width="320" height="30" as="geometry"/></mxCell><mxCell id="13" value="Layer 3: AgentRunner 自恢复 (runner.ts)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe0b2;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="355" width="620" height="32" as="geometry"/></mxCell><mxCell id="14" value="空响应 → 推引导消息重试 (max 2)&lt;br&gt;max_tokens截断 → '继续，不要复盘' (max 3)&lt;br&gt;工具异常 → catch→Error包装→ LLM自动适配" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff3e0;fontSize=10;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="40" y="393" width="620" height="55" as="geometry"/></mxCell><mxCell id="15" value="Layer 4: Logger 链路追踪 (logger.ts)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffcdd2;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="470" width="620" height="32" as="geometry"/></mxCell><mxCell id="16" value="init(id) → step(phase) [elapsed] → step(phase) → span(phase, fn)&lt;br&gt;结构化: id, phase, started_at, 每次step打印耗时&lt;br&gt;定位: 'agent_c8e fetch 1240ms FAIL→tcp timeout'" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffcdd2;fontSize=10;align=left;spacingLeft=10;" vertex="