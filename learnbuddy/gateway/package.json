    "test:e2e": "node test-e2e.mjs",
    "test:acceptance": "node test-acceptance.mjs",
    "test:all": "node test-all.mjs"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vitest": "^1.2.0",
    "ws": "^8.18.0"
  }
}
