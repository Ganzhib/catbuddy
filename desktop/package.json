{
  "name": "nanobot-desktop",
  "version": "1.0.0",
  "description": "nanobot 桌面版 - 你的个人 AI 助手",
  "author": "nanobot",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "build": {
    "appId": "ai.nanobot.desktop",
    "productName": "nanobot",
    "electronVersion": "35.1.2",
    "electronDownload": {
      "mirror": "https://npmmirror.com/mirrors/electron/"
    },
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "extraResources": [
      {
        "from": "backend/dist/nanobot-gateway.exe",
        "to": "nanobot-gateway.exe"
      }
    ],
    "files": [
      "main.js",
      "preload.js"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "nanobot"
    }
  },
  "devDependencies": {
    "electron-builder": "^26.8.1"
  }
}
