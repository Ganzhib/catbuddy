# catbuddy Desktop — 生产/打包（electron-builder）
# 复制为 apps/desktop/.env.production；打包时可一并放入 dist-electron 同级

# DeepSeek (对话)
DEEPSEEK_KEY=your-deepseek-key-here

# OpenAI (图片生成 / fallback)
OPENAI_API_KEY=your-openai-key-here

# ── Gateway 线上（默认内置，一般无需改 URL/SECRET）──
GATEWAY_ENABLED=true
CATBUDDY_GATEWAY_USE_LOCAL=false
# 内置: wss://域名/ws + catbuddy-desktop-pair-v1
# 自托管时才显式覆盖:
# GATEWAY_URL=wss://your-gateway.example/ws
# GATEWAY_SECRET=your-server-secret

# 登录后会自动同步 Web 邮箱；也可预先指定:
# GATEWAY_ACCOUNT_EMAIL=you@example.com
