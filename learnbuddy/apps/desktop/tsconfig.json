{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["../../packages/ui/src/*"],
      "@learnbuddy/ui": ["../../packages/ui/src/index.ts"],
      "@learnbuddy/ui/*": ["../../packages/ui/src/*"],
      "@learnbuddy/shared/brand": ["../../packages/shared/src/brand.d.ts"],
      "@learnbuddy/shared": ["../../packages/shared/src/index.ts"],
      "@learnbuddy/client": ["../../packages/client/src/index.ts"],
      "@learnbuddy/platform": ["../../packages/platform/src/index.ts"]
    }
  },
  "include": [
    "src/**/*",
    "../../packages/shared/src/**/*",
    "../../packages/client/src/**/*",
    "../../packages/platform/src/**/*",
    "../../packages/ui/src/**/*",
    "../../packages/platform/src/vite-env.d.ts",
    "vite-env.d.ts"
  ],
  "exclude": ["node_modules", "dist", "dist-electron", "release"]
}
