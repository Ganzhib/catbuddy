# learnbuddy Web — 开发环境
# 复制为 apps/web/.env.development（勿提交 .env.*）

# 使用 learnbuddy Gateway（默认 dev 已等价于 true，显式写出便于对照）
VITE_USE_GATEWAY=true

# 可选：覆盖 Vite 代理目标（默认 http://127.0.0.1:18765，见 vite.config.ts）
# VITE_GATEWAY_HTTP_URL=http://127.0.0.1:18765

# 可选：改用 nanobot gateway 时
# VITE_USE_GATEWAY=false
# VITE_GATEWAY_URL=http://127.0.0.1:8765
