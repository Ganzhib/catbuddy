<mxfile><diagram name="架构图" id="diagram-1"><mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="Draw.io 架构图工具链 — Prompt 工程实践" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1a1a2e;fontColor=#ffffff;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="80" y="15" width="480" height="40" as="geometry"/></mxCell><mxCell id="3" value='"反向剔除"哲学' style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="200" height="30" as="geometry"/></mxCell><mxCell id="4" value="LLM 只生成裸 mxCell&lt;br&gt;(不关心 mxfile/root 包装)&lt;br&gt;代码补全机械部分" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0e6f7;fontSize=10;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="40" y="115" width="200" height="60" as="geometry"/></mxCell><mxCell id="5" value="Prompt 迭代历程" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="280" y="80" width="480" height="30" as="geometry"/></mxCell><mxCell id="6" value="v1: 零约束 → 40%可用率" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffcdd2;fontSize=9;" vertex="1" parent="1"><mxGeometry x="280" y="115" width="160" height="30" as="geometry"/></mxCell><mxCell id="7" value="v2: +布局约束 → 55%" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe0b2;fontSize=9;" vertex="1" parent="1"><mxGeometry x="450" y="115" width="160" height="30" as="geometry"/></mxCell><mxCell id="8" value="v3: +连线5规则 → 75%" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9c4;fontSize=9;" vertex="1" parent="1"><mxGeometry x="620" y="115" width="140" height="30" as="geometry"/></mxCell><mxCell id="9" value="v4: 当前SKILL.md → 90%可用率" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="280" y="160" width="480" height="30" as="geometry"/></mxCell><mxCell id="10" value="三个工具分工" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="215" width="200" height="30" as="geometry"/></mxCell><mxCell id="11" value="display_diagram&lt;br&gt;一次性生成（造）&lt;br&gt;+ looksLikeDrawioXml() 校验" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bbdefb;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="255" width="200" height="60" as="geometry"/></mxCell><mxCell id="12" value="append_diagram&lt;br&gt;截断续写（续）&lt;br&gt;extractMxCells + ID 去重" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#90caf9;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="200" height="60" as="geometry"/></mxCell><mxCell id="13" value="edit_diagram&lt;br&gt;ID增删改（改）&lt;br&gt;cellRegex + cascade delete" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#64b5f6;fontColor=#ffffff;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="405" width="200" height="60" as="geometry"/></mxCell><mxCell id="14" value="Shape Library (按需加载)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="280" y="215" width="480" height="30" as="geometry"/></mxCell><mxCell id="15" value="get_shape_library('aws4') → EC2/S3/Lambda icons&lt;br&gt;get_shape_library('kubernetes') → K8s pod icons&lt;br&gt;get_shape_library('flowchart') → basic shapes&lt;br&gt;按需查询，不塞 System Prompt（省 token）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;fontSize=10;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="280" y="250" width="480" height="65" as="geometry"/></mxCell><mxCell id="16" value="连线五规则（突破性提升）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="280" y="340" width="480" height="30" as="geometry"/></mxCell><mxCell id="17" value="1. 平行线错开: exitY=0.3/0.7&lt;br&gt;2. 双向线: A→B右出, B→A左出&lt;br&gt;3. 每条边设 exitX/Y + entryX/Y&lt;br&gt;4. waypoint 绕过中间障碍&lt;br&gt;5. 自然连接点，不用角落" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffcdd2;fontSize=10;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="280" y="375" width="480" height="90" as="geometry"/></mxCell><mxCell id="18" value="ensureMxFile(): 包装裸mxCell为完整.drawio" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;fontSize=10;" vertex="1" parent="1"><mxGeometry x="150" y="500" width="460" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>