# learnbuddy Desktop — 复制为 apps/desktop/.env（勿提交 .env）
# 生产/已安装用户也可写在 ~/.learnbuddy.env

# DeepSeek (对话)
DEEPSEEK_KEY=your-deepseek-key-here

# OpenAI (图片生成 / fallback)
OPENAI_API_KEY=your-openai-key-here

# ── Gateway 客户端（连 learnbuddy/gateway，非 Gateway 服务端配置）──
GATEWAY_ENABLED=true
GATEWAY_URL=ws://127.0.0.1:18765/ws
GATEWAY_SECRET=dev-secret

# Gateway 服务端（MySQL、SMTP、JWT 等）见 gateway/.env.example → gateway/.env
