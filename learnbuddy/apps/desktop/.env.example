# learnbuddy Desktop — 复制为 apps/desktop/.env（勿提交 .env）
# 生产用户一般无需配置 Gateway；打包版自动连 learnbuddy.ganzhibin.iuc

# DeepSeek (对话)
DEEPSEEK_KEY=your-deepseek-key-here

# OpenAI (图片生成 / fallback)
OPENAI_API_KEY=your-openai-key-here

# ── 可选：本地开发覆盖 Gateway（默认 dev 连 127.0.0.1:18765）──
# GATEWAY_ENABLED=false          # 完全禁用远程
# LEARNBUDDY_GATEWAY_USE_LOCAL=true

# Gateway 服务端见 gateway/.env.example
