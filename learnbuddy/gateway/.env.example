# learnbuddy Gateway 独立配置
# 复制为 gateway/.env（勿提交 .env）
# 启动: docker compose up -d && pnpm run build && pnpm start

GATEWAY_PORT=18765
GATEWAY_SECRET=dev-secret
GATEWAY_WS_PATH=/gateway-ws/ws

# 必须开启邮箱登录时
GATEWAY_AUTH_REQUIRE_EMAIL=true
GATEWAY_AUTH_DEV_BYPASS=false
GATEWAY_JWT_SECRET=change-me-in-production

# MySQL（docker compose 默认账号，见 docker-compose.yml）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=learnbuddy
MYSQL_PASSWORD=learnbuddy
MYSQL_DATABASE=learnbuddy_gateway
# 或使用连接串（二选一）:
# DATABASE_URL=mysql://learnbuddy:learnbuddy@127.0.0.1:3306/learnbuddy_gateway

# ── 注册验证码邮件（QQ 邮箱示例）──
# SMTP_PASS 填 QQ 邮箱「设置 → 账户 → POP3/SMTP」里的授权码，不是 QQ 密码
SMTP_HOST=smtp.qq.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@qq.com
SMTP_PASS=your-smtp-authorization-code
SMTP_FROM=learnbuddy <your-email@qq.com>

# 若 587 失败可改用 SSL:
# SMTP_PORT=465
# SMTP_SECURE=true
