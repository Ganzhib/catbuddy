{
  "name": "@learnbuddy/gateway-workspace",
  "private": true,
  "version": "1.0.0",
  "description": "Web ⇄ Gateway ⇄ Desktop — session WS + push (monorepo)",
  "scripts": {
    "dev": "pnpm --filter @learnbuddy/gateway dev",
    "build": "pnpm --filter @learnbuddy/gateway build",
    "start": "pnpm --filter @learnbuddy/gateway start",
    "lint": "pnpm -r lint",
    "test": "vitest run",
