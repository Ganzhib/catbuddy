# learnbuddy Desktop 环境变量
# 复制此文件为 .env 并填入你的 API keys

# DeepSeek (对话)
DEEPSEEK_KEY=your-deepseek-key-here

# OpenAI (图片生成 / fallback)
OPENAI_API_KEY=your-openai-key-here

# ── Gateway（跨端 Web ↔ 桌面，可选）──
# 放在本文件（learnbuddy/.env）；Gateway 启动时会自动加载
# 终端: cd gateway && pnpm run build && pnpm start
GATEWAY_ENABLED=false
GATEWAY_URL=ws://127.0.0.1:18765/ws
GATEWAY_SECRET=dev-secret

# 真实邮箱验证码（登录页选「验证码登录」时使用）
# 不配置 SMTP 时验证码只打印在 Gateway 终端
# SMTP_HOST=smtp.qq.com
# SMTP_PORT=587
# SMTP_USER=your-qq-email@qq.com
# SMTP_PASS=your-qq-smtp-authorization-code
# SMTP_FROM=learnbuddy <your-qq-email@qq.com>

