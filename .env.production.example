# catbuddy monorepo — 生产环境
# 用法: cp .env.production.example .env.production
#
# Docker:
#   docker compose -f gateway/docker-compose.yml --env-file .env.production up -d --build
#
# Node（服务器）:
#   set NODE_ENV=production && pnpm gateway:start
#
# 桌面打包: vite 会将本文件复制到 dist-electron/.env.production

# ── Gateway ──
GATEWAY_PORT=18765
# 须与 packages/shared/src/gateway-endpoints.ts → CATBUDDY_GATEWAY_DESKTOP_SECRET
GATEWAY_SECRET=catbuddy-desktop-pair-v1
GATEWAY_WS_PATH=/ws
GATEWAY_AUTH_REQUIRE_EMAIL=true
GATEWAY_AUTH_DEV_BYPASS=false
# 必改: openssl rand -hex 32
GATEWAY_JWT_SECRET=REPLACE_WITH_RANDOM_SECRET

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=catbuddy
MYSQL_PASSWORD=catbuddy
MYSQL_DATABASE=catbuddy_gateway

SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@qq.com
SMTP_PASS=your-smtp-authorization-code
SMTP_FROM=catbuddy <your-email@qq.com>

# ── Desktop 打包 ──
GATEWAY_ENABLED=true
CATBUDDY_GATEWAY_USE_LOCAL=false
# GATEWAY_ACCOUNT_EMAIL=you@example.com

DEEPSEEK_KEY=your-deepseek-key-here
# OPENAI_API_KEY=your-openai-key-here

# ── Web 生产构建 ──
VITE_USE_GATEWAY=true
