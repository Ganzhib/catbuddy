{
  "name": "learnbuddy-desktop",
  "private": true,
  "version": "0.1.0",
  "description": "learnbuddy desktop — AI agent powered by Electron + React",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && electron-builder",
    "build:unpack": "tsc && vite build && electron-builder --dir",
    "build:unpack:fresh": "tsc && vite build && electron-builder --dir --config.directories.output=release-fresh",
    "kill-app": "taskkill /IM learnbuddy.exe /F 2>nul || exit 0",
    "rebuild:unpack": "pnpm run kill-app && pnpm run build:unpack",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "brand:generate": "node scripts/generate-brand.mjs",
    "brand:cutout": "node scripts/remove-icon-background.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.37.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "handlebars": "^4.7.8",
    "i18next": "^26.0.6",
    "js-tiktoken": "^1.0.19",
    "lucide-react": "^0.469.0",
    "nanoid": "^5.0.0",
    "openai": "^4.73.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.4",
    "react-markdown": "^9.0.1",
    "react-syntax-highlighter": "^15.6.1",
    "rehype-katex": "^7.0.1",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.4",
    "@radix-ui/react-avatar": "^1.1.2",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-scroll-area": "^1.2.2",
    "@radix-ui/react-separator": "^1.1.1",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-tooltip": "^1.1.6",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.1",
    "electron-builder": "^25.0.0",
    "katex": "^0.16.21",
    "postcss": "^8.5.0",
    "semver": "^7.6.0",
    "sharp": "^0.33.5",
    "@imgly/background-removal-node": "^1.4.5",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.7.2",
    "vite": "^5.4.21",
    "vite-plugin-electron": "^0.28.0",
    "vite-plugin-electron-renderer": "^0.14.0",
    "vitest": "^2.1.8"
  },
  "build": {
    "appId": "com.learnbuddy.desktop",
    "productName": "learnbuddy",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "electron/assets/**/*",
      "templates/**/*",
      "skills/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "electron/assets/icon.png"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "electron/assets/icon.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "electron/assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "sharp",
      "onnxruntime-node"
    ],
    "overrides": {
      "@imgly/background-removal-node>sharp": "$sharp"
    }
  }
}
