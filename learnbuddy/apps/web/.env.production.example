# learnbuddy Web — 生产构建（pnpm build:web 前复制为 apps/web/.env.production）
# 勿提交 .env.production

# 生产必须显式开启（import.meta.env.PROD 下无 dev 默认值）
VITE_USE_GATEWAY=true

# 推荐：与 Web 同域反代 /gateway-api → Gateway（见 README 环境变量一节）
VITE_GATEWAY_HTTP_URL=/gateway-api

# 或跨域直连公网 Gateway（需 Gateway 开启 CORS + wss）
# VITE_GATEWAY_HTTP_URL=https://gateway.example.com
