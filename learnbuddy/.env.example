# learnbuddy Desktop 环境变量
# 复制此文件为 .env 并填入你的 API keys

# DeepSeek (对话)
DEEPSEEK_KEY=your-deepseek-key-here

# OpenAI (图片生成 / fallback)
OPENAI_API_KEY=your-openai-key-here

# ── Cross-device relay (optional) ──
# Run: cd relay-server && RELAY_SECRET=dev-secret pnpm start
RELAY_ENABLED=false
RELAY_URL=ws://127.0.0.1:18765/ws
RELAY_SECRET=dev-secret
# RELAY_DEVICE_ID=my-desktop
# RELAY_DEFAULT_SESSIONS=desktop:main

# Web viewer (Vite apps/web — future)
# VITE_RELAY_HTTP_BASE=http://127.0.0.1:18765
# VITE_RELAY_VIEWER_TOKEN=web-viewer-1
