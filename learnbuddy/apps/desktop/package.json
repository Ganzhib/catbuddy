{
  "name": "@learnbuddy/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "learnbuddy desktop — Electron + local agent",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && electron-builder",
    "build:unpack": "tsc --noEmit && vite build && electron-builder --dir",
    "build:unpack:fresh": "tsc --noEmit && vite build && electron-builder --dir --config.directories.output=release-fresh",
    "kill-app": "taskkill /IM learnbuddy.exe /F 2>nul || exit 0",
    "rebuild:unpack": "pnpm run kill-app && pnpm run build:unpack",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "gateway:dev": "pnpm --filter @learnbuddy/gateway dev",
    "gateway:test": "node ../../gateway/test-all.mjs",
    "brand:generate": "node ../../scripts/generate-brand.mjs",
    "brand:cutout": "node ../../scripts/remove-icon-background.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.37.0",
    "@learnbuddy/client": "workspace:*",
    "@learnbuddy/gateway-sdk-desktop": "workspace:*",
    "@learnbuddy/platform": "workspace:*",
    "@learnbuddy/shared": "workspace:*",
    "@learnbuddy/ui": "workspace:*",
    "handlebars": "^4.7.8",
    "js-tiktoken": "^1.0.19",
    "nanoid": "^5.0.0",
    "openai": "^4.73.0",
    "ws": "^8.18.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.1",
    "electron-builder": "^25.0.0",
    "postcss": "^8.5.0",
    "semver": "^7.6.0",
    "sharp": "^0.33.5",
    "@imgly/background-removal-node": "^1.4.5",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "@tailwindcss/typography": "^0.5.19",
    "typescript": "^5.7.2",
    "vite": "^5.4.21",
    "vite-plugin-electron": "^0.28.0",
    "vite-plugin-electron-renderer": "^0.14.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "build": {
    "appId": "com.learnbuddy.desktop",
    "productName": "learnbuddy",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "electron/assets/**/*",
      "templates/**/*",
      "skills/**/*"
    ],
    "win": {
      "target": ["nsis"],
      "icon": "electron/assets/icon.png"
    },
    "mac": {
      "target": ["dmg"],
      "icon": "electron/assets/icon.png"
    },
    "linux": {
      "target": ["AppImage"],
      "icon": "electron/assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
