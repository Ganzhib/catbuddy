{
  "name": "@learnbuddy/gateway",
  "private": true,
  "version": "0.2.0",
  "description": "learnbuddy gateway — Web ↔ desktop executor (NestJS)",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:legacy": "node server.mjs",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test": "node test-e2e.mjs",
    "test:acceptance": "node test-acceptance.mjs",
    "test:all": "node test-all.mjs",
    "clear:users": "node scripts/clear-auth-users.mjs",
    "clear:users:sessions": "node scripts/clear-auth-users.mjs --sessions",
    "test:smtp": "node scripts/test-smtp.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/platform-ws": "^10.4.15",
    "@nestjs/websockets": "^10.4.15",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "nodemailer": "^6.9.16",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^6.4.17",
    "@types/ws": "^8.5.13",
    "typescript": "^5.7.2"
  }
}
